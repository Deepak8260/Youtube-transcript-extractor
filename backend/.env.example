# Copy to backend/.env and adjust. Every setting is optional.

# --- Storage -----------------------------------------------------------------
# Relative paths are resolved against the backend/ directory.
OUTPUT_DIR=./transcripts
TEMP_DIR=./temp

# --- Transcripts ---------------------------------------------------------------
DEFAULT_LANGUAGE=en
# If no caption track exists in the requested language, use the video's own
# language before falling back to Whisper.
ALLOW_OTHER_LANGUAGES=true
# Strip non-speech cues such as [Music] and [Applause].
REMOVE_NON_SPEECH=true
# 0 = one timestamp per caption segment. e.g. 30 = join segments into ~30s blocks
# (lossless: every word is kept, the block uses its first segment's timestamp).
SEGMENT_GROUP_SECONDS=0

# --- Whisper fallback ----------------------------------------------------------
ENABLE_WHISPER_FALLBACK=true
# tiny | base | small | medium | large-v3 | turbo
WHISPER_MODEL=small
# auto | cpu | cuda
WHISPER_DEVICE=auto
# default | int8 | float16 | int8_float16 ...
WHISPER_COMPUTE_TYPE=default
# Force a language for Whisper (e.g. en). Empty = auto-detect.
WHISPER_LANGUAGE=
# Also use Whisper when YouTube rate-limits caption requests (slow; off by default).
WHISPER_ON_RATE_LIMIT=false
# Fall back to the text in YouTube's "Show transcript" panel when the caption
# server fails or blocks this IP (different endpoint, often still allowed).
ENABLE_TRANSCRIPT_PANEL=true
# After YouTube blocks a caption download, pause caption requests for this long.
CAPTION_BLOCK_COOLDOWN_SECONDS=900
MAX_AUDIO_DURATION_SECONDS=14400
MAX_AUDIO_FILESIZE_MB=500
WHISPER_TIMEOUT_SECONDS=10800

# --- Playlists & throughput ------------------------------------------------------
MAX_PLAYLIST_VIDEOS=500
PLAYLIST_CONCURRENCY=2
REQUEST_DELAY_SECONDS=0.5
MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=2
NETWORK_TIMEOUT_SECONDS=30
# Optional proxy for all YouTube traffic (captions, metadata, audio), e.g. when
# YouTube blocks your IP: http://user:pass@proxy.example.com:8080
PROXY_URL=
MAX_CONCURRENT_JOBS=2
JOB_RETENTION_HOURS=24

# --- HTTP ------------------------------------------------------------------------
# JSON list. Only needed if the UI is served from a different origin than /api.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LOG_LEVEL=INFO
